# Generated Dart and Flutter artifacts
.dart_tool/
build/
.packages
example/.dart_tool/
example/build/

# Local editor and diagnostic files
*.iml
*.log

# The example consumes copied development assets locally. The library
# intentionally publishes no boundary data, so the whole directory goes rather
# than a list of names: pub uses this file *instead of* .gitignore, so anything
# added to .gitignore alone still ends up in the archive. Enumerating the
# directories missed example/assets/subdistricts/ exactly that way.
example/assets/
