{
  "name": "bharat-choropleth",
  "version": "0.1.0",
  "description": "Accessible, dependency-light SVG choropleths for India drill-down dashboards.",
  "keywords": [
    "choropleth",
    "india",
    "map",
    "react",
    "svg",
    "topojson"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashankbudem/bharat-choropleth.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/shashankbudem/bharat-choropleth#readme",
  "bugs": {
    "url": "https://github.com/shashankbudem/bharat-choropleth/issues"
  },
  "type": "module",
  "sideEffects": ["./dist/style.css"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.2",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --external react --external react-dom && cp src/style.css dist/style.css",
    "prepack": "pnpm run build && pnpm run typecheck",
    "prepublishOnly": "pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
